// The icon Windows shows in Explorer, the taskbar and the title bar, plus the
// version details in the file's Properties dialog. Compiled by build.rs.

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,2,4,0
PRODUCTVERSION 0,2,4,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Folio"
            VALUE "FileDescription", "Folio - Story Studio"
            VALUE "FileVersion", "0.2.4"
            VALUE "InternalName", "folio"
            VALUE "OriginalFilename", "Folio.exe"
            VALUE "ProductName", "Folio"
            VALUE "ProductVersion", "0.2.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
